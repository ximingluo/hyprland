//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "gutter": {
    "breakpoints": false,
    "bookmarks": false,
    "runnables": false,
    "folds": false,
    "min_line_number_digits": 2
  },
  "git": {
    "git_gutter": "tracked_files"
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 12,
    "sticky_scroll": false
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "group_by": "staging",
    "dock": "left"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "unnecessary_code_fade": 0.3,
  "text_rendering_mode": "platform_default",
  "cursor_blink": true,
  "buffer_font_weight": 395.0,
  "edit_predictions": {
    "sweep": {
      "privacy_mode": false
    },
    "provider": "zed"
  },
  "disable_ai": false,
  "agent": {
    "dock": "right",
    "default_model": {
      "effort": "high",
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "buffer_line_height": "comfortable",
  "cursor_shape": "bar",
  "agent_buffer_font_size": 16.0,
  "agent_ui_font_size": 18.0,
  "ui_font_weight": 500.0,
  "ui_font_family": ".SystemUIFont",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "qwen-code": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
