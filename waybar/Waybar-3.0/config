{ 
  "layer": "bottom",
  "position": "top",
  "height": 16,
  "margin-top": 5,
  "margin-left": 10,
  "margin-bottom": -5,
  "margin-right": 10,
  "spacing": 0,

  "modules-left": [
    "custom/launcher",
    "cpu",
    "memory",
    "custom/gpu-info",
    "custom/gpu-temperature",
    "custom/filler",
    "disk",
    "custom/uptime",
    "battery",
    "custom/playerctl"
  ],
  "modules-center": ["ext/workspaces"],
  "modules-right": [
    "custom/power",
    "custom/dot-power",
    "backlight",
    "pulseaudio",
    "custom/dot",
    "custom/bluetooth",
    "custom/dot-bluetooth",
    "network",
    "custom/niflveil",
    "custom/dot",
    "tray",
    "clock"
  ], 
  "custom/playerctl": {
      "format": "[<span foreground='#46c880'>  </span> <span>{}</span> ]",
      "return-type": "json",
      "max-length": 55,
      "exec": "playerctl -a metadata --format '{\"text\": \"{{playerName}}\"}' -F",
      "on-click": "playerctl play-pause",
      "on-click-middle": "playerctl previous",
      "on-click-right": "playerctl next",
      "format-icons": {
        "Playing": "<span foreground='#46c880'>  </span>",
        "Paused": "<span foreground='#cdd6f4'> 󰏥 </span>"
      }
    },
    "custom/uptime": {
    "format": "  {}",
    "return-type": "json",
    "interval": 1,
    "exec": "$HOME/.config/waybar/scripts/uptime.sh",
    "on-click" : ""
  },
     "disk": {
    "interval": 5,
    "format": "<span color=\"#68b0d6\"></span> {percentage_used}%",
    "on-click": "env QT_SCALE_FACTOR=0.8 filelight /",
    "on-click-right": "env QT_SCALE_FACTOR=0.8 filelight /home/ximing/"
  },
  "ext/workspaces": {
    "all-outputs": true,
    "active-only": false,
    "sort-by-id": true,
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "$HOME/.config/hypr/scripts/cycle_workspace.py prev",
    "on-scroll-down": "$HOME/.config/hypr/scripts/cycle_workspace.py next",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
      "urgent": "",
      "active": "",
      "default": ""
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/filler": {
    "format": "",
    "tooltip": false
  },
  "custom/dot": {
    "format": "",
    "tooltip": false
  },
  "custom/dot-power": {
    "format": "",
    "tooltip": false
  },
  "custom/dot-bluetooth": {
    "format": "",
    "tooltip": false
  },
  "custom/clock-icon": {
    "format": ""
  },

  "clock": {
    "format": "<b>{:%I:%M %p }</b>",
    "format-alt": "<b>{:%a.%d,%b}</b>",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "cpu": {
    "interval": 1,
    "format": " {usage}%",
    "max-length": 10,
    "on-click-right": "kitty --class htop htop"
  },
  "memory": {
    "interval": 1,
    "format": " {}%",
    "format-alt": " {used:0.1f}G",
    "max-length": 10,
    "on-click-right": "missioncenter"
  },
  "custom/gpu-info": {
    "format": "{}",
    "interval": 1,
    "exec": "$HOME/.config/waybar/scripts/gpu-smart.sh",
    "return-type": "json",
    "on-click": "$HOME/.config/waybar/scripts/gpu-smart.sh toggle && pkill -RTMIN+8 waybar",
    "on-click-right": "kitty --class nvtop nvtop",
    "tooltip": true,
    "max-length": 15
  },
  "backlight": {
    "device": "amdgpu_bl1",
    "format": "{icon} {percent} ",
    "tooltip": false,
    "format-icons": ["", "", "", "", "", "", "", "", ""]
  },
  "network": {
    "interval": 1,
    "format-wifi": "󰒢 {essid}",
    "format-alt" : "󰒢 {bandwidthTotalBits}",
    "on-click": "",
    "on-click-right": "networkmanager_dmenu",
    "format-ethernet": " wired",
    "tooltip-format": "{essid} {signalStrength}%",
    "format-disconnected": "󰤭"
  },

  "pulseaudio": {
    "format": "{icon}  <b>{volume}</b>",
    "format-bluetooth": "<span letter_spacing=\"768\"> </span>{volume}",
    "format-bluetooth-muted": " ",
    "tooltip": false,
    "format-muted": "",
    "format-icons": {
      "default": ["󰝟", "", "󰕾" , ""]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "interval": 1
  },
  "battery": {
    "bat": "BAT1",
    "interval": 1,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": " {icon} {capacity}%",
    "format-charging": " {icon} {capacity}%",
    "format-icons": ["", "", "", "", "", "", "", "", "", ""],
    "max-length": 25,
    "tooltip": false
  },
  "custom/power": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/power-profile.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "$HOME/.config/waybar/scripts/power-profile.sh toggle && pkill -RTMIN+9 waybar",
    "on-click-right": "$HOME/.config/waybar/scripts/power-profile.sh balanced && pkill -RTMIN+9 waybar",
    "tooltip": true
  },
  "custom/right-arr": {
    "format": "  "
  },
  "custom/launcher": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/launcher.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "kitty --class fastfetch --hold fastfetch"
  },
  "custom/window-name": {
    "format": " <b>{}</b>",
    "interval": 1,
    "exec": "hyprctl activewindow | grep class | awk '{print $2}'"
  },

 "custom/bluetooth": {
   "format": "{}",
   "return-type": "json",
   "exec": "$HOME/.config/waybar/scripts/bluetooth.sh",
   "interval": 1,
   "signal": 10,
   "on-click": "$HOME/.config/waybar/scripts/bluetooth.sh toggle && pkill -RTMIN+10 waybar",
   "on-click-right": "env GTK_THEME=Axon blueman-manager"
 },
  "custom/niflveil": {
    "format": "{}",
    "exec": "niflveil show",
    "on-click": "$HOME/.config/waybar/scripts/niflveil-tray.py",
    "return-type": "json",
    "interval": "once",
    "signal": 8
  },
  "custom/window-icon": {},

  "custom/gpu-temperature": {
    "interval": 1,
    "exec": "$HOME/.config/waybar/scripts/gpu-temp.sh",
    "format": "{}",
    "return-type": "json",
    "tooltip": true,
    "on-click": ""
  },

  "custom/wrap-left": {
    "format": "<b>[</b>"
  },

  "custom/wrap-right": {
    "format": "<b>]</b>"
  }
}
